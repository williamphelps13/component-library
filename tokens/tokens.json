{
  "core": {
    "color": {
      "blue": {
        "300": { "$value": "oklch(0.78 0.12 256)", "$type": "color" },
        "500": { "$value": "oklch(0.62 0.19 256)", "$type": "color" },
        "600": { "$value": "oklch(0.50 0.19 256)", "$type": "color" }
      },
      "gray": {
        "100": { "$value": "oklch(0.97 0 0)", "$type": "color" },
        "900": { "$value": "oklch(0.22 0 0)", "$type": "color" }
      },
      "white": { "$value": "oklch(1 0 0)", "$type": "color" },
      "red": {
        "500": { "$value": "oklch(0.58 0.22 27)", "$type": "color" }
      },
      "green": {
        "500": { "$value": "oklch(0.52 0.12 150)", "$type": "color" }
      }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.5rem", "$type": "dimension" },
      "2": { "$value": "1rem", "$type": "dimension" },
      "3": { "$value": "1.5rem", "$type": "dimension" },
      "4": { "$value": "2rem", "$type": "dimension" },
      "5": { "$value": "2.5rem", "$type": "dimension" },
      "6": { "$value": "3rem", "$type": "dimension" },
      "8": { "$value": "4rem", "$type": "dimension" },
      "10": { "$value": "5rem", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm": { "$value": "0.25rem", "$type": "dimension" },
      "md": { "$value": "0.5rem", "$type": "dimension" },
      "lg": { "$value": "1rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "level-1": {
        "$value": "0 1px 2px 0 rgba(0, 0, 0, 0.08), 0 1px 3px 0 rgba(0, 0, 0, 0.06)",
        "$type": "boxShadow"
      },
      "level-2": {
        "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.12), 0 2px 4px -1px rgba(0, 0, 0, 0.08)",
        "$type": "boxShadow"
      },
      "level-3": {
        "$value": "0 6px 10px -2px rgba(0, 0, 0, 0.14), 0 3px 6px -1px rgba(0, 0, 0, 0.09)",
        "$type": "boxShadow"
      },
      "level-4": {
        "$value": "0 8px 16px -4px rgba(0, 0, 0, 0.15), 0 4px 8px -2px rgba(0, 0, 0, 0.1)",
        "$type": "boxShadow"
      },
      "none": { "$value": "0 0 #0000", "$type": "boxShadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "350ms", "$type": "duration" }
    },
    "font-size": {
      "sm": { "$value": "0.8125rem", "$type": "dimension" },
      "md": { "$value": "0.875rem", "$type": "dimension" },
      "lg": { "$value": "0.9375rem", "$type": "dimension" }
    },
    "font-weight": {
      "semibold": { "$value": "600", "$type": "fontWeight" }
    }
  },
  "light": {
    "color": {
      "primary-bg": { "$value": "{color.blue.600}", "$type": "color" },
      "primary-fg": { "$value": "{color.white}", "$type": "color" },
      "neutral-bg": { "$value": "{color.gray.100}", "$type": "color" },
      "neutral-fg": { "$value": "{color.gray.900}", "$type": "color" },
      "danger-bg": { "$value": "{color.red.500}", "$type": "color" },
      "danger-fg": { "$value": "{color.white}", "$type": "color" },
      "success-bg": { "$value": "{color.green.500}", "$type": "color" },
      "success-fg": { "$value": "{color.white}", "$type": "color" },
      "ring": { "$value": "{color.blue.500}", "$type": "color" }
    },
    "shadow": {
      "resting": { "$value": "{shadow.level-1}", "$type": "boxShadow" },
      "raised": { "$value": "{shadow.level-2}", "$type": "boxShadow" },
      "focus": { "$value": "{shadow.level-3}", "$type": "boxShadow" },
      "pressed": { "$value": "{shadow.level-4}", "$type": "boxShadow" },
      "flat": { "$value": "{shadow.none}", "$type": "boxShadow" }
    }
  },
  "dark": {
    "color": {
      "primary-bg": { "$value": "{color.blue.300}", "$type": "color" },
      "primary-fg": { "$value": "{color.gray.900}", "$type": "color" },
      "neutral-bg": { "$value": "{color.gray.900}", "$type": "color" },
      "neutral-fg": { "$value": "{color.gray.100}", "$type": "color" },
      "danger-bg": { "$value": "{color.red.500}", "$type": "color" },
      "danger-fg": { "$value": "{color.white}", "$type": "color" },
      "success-bg": { "$value": "{color.green.500}", "$type": "color" },
      "success-fg": { "$value": "{color.white}", "$type": "color" },
      "ring": { "$value": "{color.gray.100}", "$type": "color" }
    },
    "shadow": {
      "resting": { "$value": "{shadow.level-1}", "$type": "boxShadow" },
      "raised": { "$value": "{shadow.level-2}", "$type": "boxShadow" },
      "focus": { "$value": "{shadow.level-3}", "$type": "boxShadow" },
      "pressed": { "$value": "{shadow.level-4}", "$type": "boxShadow" },
      "flat": { "$value": "{shadow.none}", "$type": "boxShadow" }
    }
  },
  "$themes": [],
  "$metadata": { "tokenSetOrder": ["core", "light", "dark"] }
}
