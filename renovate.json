{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "github-actions"],
  "schedule": ["* 0-8 * * 5"],
  "minimumReleaseAge": "1 day",
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "configMigration": true,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-8 * * 5"]
  },
  "major": {
    "description": "Majors are opt-in from the Dependency Dashboard — includes Storybook majors, which get a manual CSF Next audit per CLAUDE.md",
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "groupName": "minor and patch dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Action digest-pin maintenance is mechanical — automerge",
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "automerge": true
    }
  ]
}
