{
  "name": "@williamphelps13/ui",
  "version": "0.3.0",
  "description": "RSC-first React 19 component library for Next.js App Router and Vite — precompiled CSS, themeable via --ui-* variables",
  "keywords": [
    "react",
    "react-19",
    "component-library",
    "design-system",
    "server-components",
    "rsc",
    "nextjs",
    "css-variables",
    "themeable",
    "esm"
  ],
  "author": "William Phelps (https://github.com/williamphelps13)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamphelps13/component-library.git"
  },
  "homepage": "https://github.com/williamphelps13/component-library#readme",
  "bugs": "https://github.com/williamphelps13/component-library/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/**/*.{ts,tsx}",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "!src/styles/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/assert-theme-parity.mjs && node style-dictionary.config.mjs",
    "css": "node scripts/assert-css-imports.mjs && lightningcss --bundle --minify src/styles/index.css -o dist/styles.css && node scripts/assert-css-layers.mjs",
    "css:watch": "node scripts/css-watch.mjs",
    "build": "pnpm tokens && tsdown --tsconfig tsconfig.build.json && pnpm css",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "pnpm css && vitest run --coverage",
    "knip": "knip",
    "spell": "cspell \"**/*.md\" \"src/**\" \".storybook/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.{ts,mjs,json}\"",
    "assert:use-client": "node scripts/assert-use-client.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "verify:pack": "node scripts/assert-pack-contents.mjs && publint",
    "verify:types": "attw --pack --profile esm-only --exclude-entrypoints styles.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --config-file chromatic.config.json",
    "prepublishOnly": "pnpm build && pnpm verify:pack && pnpm assert:use-client && pnpm smoke:dist",
    "release": "pnpm changeset publish"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.1",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@babel/core": "^8.0.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "chromatic": "^18.0.0",
    "cspell": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.4",
    "jiti": "^2.7.0",
    "knip": "^6.16.1",
    "lightningcss-cli": "^1.32.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.4.4",
    "storybook-addon-pseudo-states": "^10.4.6",
    "style-dictionary": "^5.4.4",
    "tsdown": "^0.22.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
